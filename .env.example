# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BASE_URL=http://localhost:8000

# PostgreSQL (base.py default port is 5433)
POSTGRES_DB=raqnith
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# PayMongo (test keys during development)
PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=whsec_

# Email — console backend by default (receipts print to the runserver log).
# For real delivery switch to SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=receipts@yourdomain.com
# EMAIL_HOST_PASSWORD=app-password-here
DEFAULT_FROM_EMAIL=Virtus <receipts@yourdomain.com>

# Ops alerts — where "webhook failing" emails go (empty = log only).
DJANGO_ADMIN_NOTIFY_EMAIL=ops@yourdomain.com
WEBHOOK_ALERT_THRESHOLD=3

# Download fairness cap per order per day (0 disables).
MAX_DOWNLOADS_PER_DAY=20
